IMAGE_VERSION=0
SERVER_PREFIX=dev.
ENVIRONMENT=dev

# Backend Variables
DATABASE_URL=SECRET_DEV_DATABASE_URL

S3_URL=https://us-southeast-1.linodeobjects.com
S3_BUCKET=SECRET_DEV_S3_BUCKET
S3_ACCESS_KEY=SECRET_DEV_S3_ACCESS_KEY
S3_SECRET_KEY=SECRET_DEV_S3_SECRET_KEY

# Frontend Variables
API_URL=http://backend:8000/api/v1
NEXT_PUBLIC_INTERNAL_API_URL=
NEXT_PUBLIC_VERSION=$IMAGE_VERSION

API_KEY=SECRET_DEV_FRONTEND_API_KEY
API_CLIENT_NAME=SECRET_DEV_FRONTEND_API_CLIENT
NEXT_PUBLIC_CLIENT_PUBLIC_ID=SECRET_DEV_FRONTEND_CLIENT_PUBLIC_ID

JWT_SECRET=SECRET_DEV_JWT_SECRET
JWT_EXPIRY_MIN=SECRET_DEV_JWT_EXPIRY_MIN